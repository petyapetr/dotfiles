[core]
	editor = vim
  excludesfile = ~/.gitignore
	pager = hunk pager

[color]
  diff = auto
  status = auto
  branch = auto
	ui = true

[push]
	default = current

[remote]
  pushDefault = origin

[branch]
	autosetuprebase = always

[pull]
	rebase = true

[init]
	defaultBranch = main

[credential "https://github.com"]
# MacOS
	helper = !/opt/homebrew/bin/gh auth git-credential
# Windows
	# helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
# MacOS
	helper = !/opt/homebrew/bin/gh auth git-credential
# Windows
	# helper = !/usr/bin/gh auth git-credential

[alias]
	l = "!. ~/.githelpers && pretty_git_log"
	la = "!git l --all"
	lr = "!git l -20"
	ss = "status"
	sss = "status --short"
	c = "commit"
	cm = "commit -m"
	cam = "!f() { git add -A && git commit -m \"$1\"; }; f"
	cw = "commit -m '(wip)'"
	caw = "! git add -A && git commit -m '(wip)'"
	amend = "commit --amend --no-edit"
	ammend = "commit --amend --no-edit"
	a = "add"
	aa = "add -A"
	d = "diff"
	dc = "diff --cached"
	sw = "switch"
	swc = "switch -c"
	b = "branch"
	br = "branch -r"
	bd = "branch -D"
	brd = "push origin --delete"
	rb = "rebase"
	rbi = "!f() { git rebase -i HEAD~\"$1\"; }; f"
	abort = "rebase --abort"
	rs = "reset"
	rsh = "reset --hard"
	latest = "reset HEAD^"
	last = "reset HEAD^"
	stls = "stash list"
	st = "stash push"
	sts = "stash push --staged"
	stu = "stash push --keep-index" # u for unstaged
	stp = "stash pop"
	sta = "stash apply"
	p = "push"
	pf = "push --force"	
	f = "fetch"
	fp = "fetch --prune"
	sync = "!git fetch --all --prune && git pull --rebase"
	yeet = "!f() { git add -A && git commit -m \"$1\" && git push; }; f"
	i = "init"
